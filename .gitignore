*.[oa]
*~
*.tri
_vtk/*
_adc/*
_mesh/*
*.par
*.vtk
*.swp
*.pyc
/stage1-work/

build/

# Campaign literature PDFs stay untracked (copyright); index in literature/README.md
literature/*.pdf

# big untracked run/build output dirs - guard against accidental staging
/build-*/
/q2p1_*_rundir_*/
/results/
paraview/
_dump/
_gmv/
_vtk/

# vendored CI benchmark case (overrides _adc/*, *.tri, *.par above)
!_adc/2D_FAC/
!_adc/2D_FAC/*

# vendored Chimera FAC case (channel background mesh from
# tools/chimera_meshgen/channel_tri.py; overrides *.tri, *.par above)
!applications/q2p1_chimera/_data/CHIMERA_FAC/
!applications/q2p1_chimera/_data/CHIMERA_FAC/*
